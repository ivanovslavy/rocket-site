# ─── $ROCKET frontend env template ─────────────────────────────────────
# Only client-safe values. RPC API keys live in server/.env (backend proxy).

# 'sepolia' (testing) or 'mainnet' (launch)
VITE_CHAIN=sepolia

# Token contract per chain (swap goes live once the active chain's CA is set)
VITE_TOKEN_ADDRESS_SEPOLIA=
VITE_TOKEN_ADDRESS_MAINNET=

# Which Uniswap version the token's liquidity lives on: v2 | v3 | v4 (default v3)
VITE_SWAP_VERSION=v3

# v4 ONLY — pool is keyed by (fee, tickSpacing, hooks); cannot be auto-detected.
# Defaults below are a plain 0.30% no-hook pool. Override per token if needed.
VITE_V4_FEE=3000
VITE_V4_TICK_SPACING=60
VITE_V4_HOOKS=0x0000000000000000000000000000000000000000

# WalletConnect Cloud project id (public by design)
VITE_WALLETCONNECT_PROJECT_ID=

# Key-holding RPC proxy URL (see server/). Public RPCs first, this is fallback.
VITE_BACKEND_URL=http://localhost:8787
